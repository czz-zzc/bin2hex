#!/usr/bin/env python3
"""Convert a binary file to a Verilog $readmemh-compatible hex file."""

import argparse
import os
import sys


def bin2hex(input_file, output_file, word_bytes, mem_depth, endian='little', binary=False, split=1):
    with open(input_file, 'rb') as f:
        data = f.read()

    data_words = (len(data) + word_bytes - 1) // word_bytes
    print(f"Input size  : {len(data)} bytes")
    print(f"Word width  : {word_bytes * 8} bits ({word_bytes} bytes/word)")
    print(f"Byte order  : {endian}-endian")
    if binary:
        print(f"Output fmt  : binary ($readmemb)")
    else:
        print(f"Output fmt  : hex ($readmemh)")
    print(f"Data words  : {data_words}")

    if mem_depth is not None:
        if data_words > mem_depth:
            print(f"WARNING: data ({data_words} words) exceeds mem_depth ({mem_depth}), truncating.")
        pad_words = max(0, mem_depth - data_words)
        print(f"Mem depth   : {mem_depth} (padding {pad_words} zero words)")

    if binary:
        zero_word = '0' * word_bytes * 8
    else:
        zero_word = '00' * word_bytes

    def fmt_chunk(chunk):
        chunk = chunk.ljust(word_bytes, b'\x00')  # pad last word if needed
        if endian == 'little':
            chunk = chunk[::-1]  # reverse bytes: little-endian file -> big-endian hex value
        if binary:
            return format(int.from_bytes(chunk, 'big'), '0{}b'.format(word_bytes * 8))
        return chunk.hex()

    if split > 1:
        if mem_depth is None:
            print("ERROR: --split requires --mem-depth to be set", file=sys.stderr)
            sys.exit(1)
        if mem_depth % split != 0:
            print(f"ERROR: mem_depth ({mem_depth}) must be divisible by split count ({split})",
                  file=sys.stderr)
            sys.exit(1)
        per_file = mem_depth // split
        print(f"Split       : {split} files, {per_file} words/file")

        # collect all words, pad/truncate to mem_depth
        words = []
        for i in range(0, len(data), word_bytes):
            if len(words) >= mem_depth:
                break
            words.append(fmt_chunk(data[i:i + word_bytes]))
        while len(words) < mem_depth:
            words.append(zero_word)

        base, ext = os.path.splitext(output_file)
        for fi in range(split):
            start = fi * per_file
            sub_file = f"{base}_{fi}{ext}"
            with open(sub_file, 'w') as f:
                for w in words[start:start + per_file]:
                    f.write(w + '\n')
            print(f"Output file : {sub_file}")
    else:
        with open(output_file, 'w') as f:
            written = 0
            for i in range(0, len(data), word_bytes):
                if mem_depth is not None and written >= mem_depth:
                    break
                chunk = data[i:i + word_bytes]
                chunk = chunk.ljust(word_bytes, b'\x00')  # pad last word if needed
                if endian == 'little':
                    chunk = chunk[::-1]  # reverse bytes: little-endian file -> big-endian hex value
                if binary:
                    f.write(format(int.from_bytes(chunk, 'big'), '0{}b'.format(word_bytes * 8)) + '\n')
                else:
                    f.write(chunk.hex() + '\n')
                written += 1
            if mem_depth is not None:
                for _ in range(mem_depth - written):
                    f.write(zero_word + '\n')

        print(f"Output file : {output_file}")


def parse_args():
    parser = argparse.ArgumentParser(
        description='Convert a binary file to a Verilog $readmemh-compatible hex file.'
    )
    parser.add_argument('-i', '--input',      required=True,  metavar='FILE',  help='Input binary file')
    parser.add_argument('-o', '--output',     required=True,  metavar='FILE',  help='Output hex file')
    parser.add_argument('-w', '--word-bytes', type=int, default=8, metavar='N',
                        help='Bytes per memory word (default: 8 for 64-bit; use 4 for 32-bit, etc.)')
    parser.add_argument('-d', '--mem-depth',  type=int, default=None, metavar='N',
                        help='Memory depth in words. If set, output is zero-padded to this length.')
    parser.add_argument('-e', '--endian', choices=['little', 'big'], default='little',
                        help='Byte order of the input binary file (default: little). '
                             'Use "big" if the file is already in big-endian (MSB first).')
    parser.add_argument('-b', '--binary', action='store_true',
                        help='Output binary format instead of hex (for $readmemb).')
    parser.add_argument('-s', '--split', type=int, default=1, metavar='N',
                        help='Split output into N files, each with mem_depth/N words. '
                             'Requires --mem-depth. mem_depth must be divisible by N. '
                             'Files are named <base>_<i><ext> (e.g. out.rcf -> out_0.rcf ...). '
                             'Default: 1 (no split, original behavior).')
    return parser.parse_args()


if __name__ == '__main__':
    args = parse_args()

    if not os.path.exists(args.input):
        print(f"ERROR: input file not found: '{args.input}'", file=sys.stderr)
        sys.exit(1)

    bin2hex(args.input, args.output, args.word_bytes, args.mem_depth, args.endian, args.binary, args.split)
